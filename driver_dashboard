</div></div>
<script type="module">
import { createClient } from 'https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.39.0/+esm'
const URL='https://wjmotidelqgcyyujacud.supabase.co'
const KEY=localStorage.getItem('tempera_anon_key_bener')||''
if(!KEY){location.href='login.html'}
const supabase=createClient(URL,KEY)
async function init(){
 const {data:{user}}=await supabase.auth.getUser()
 if(!user){location.href='login.html';return}
 document.getElementById('welcome').innerText='Halo '+user.email+' ✅'
 document.getElementById('d_email').innerText=user.email
 const {data:driver}=await supabase.from('drivers').select('*').eq('email',user.email).single()
 if(driver){
   document.getElementById('d_nama').innerText=driver.nama
   document.getElementById('d_hp').innerText=driver.hp
   document.getElementById('d_plat').innerText=driver.plat
