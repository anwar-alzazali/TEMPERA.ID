<div class="container py-4" style="max-width:800px">
<div class="card p-4"><div class="d-flex justify-content-between align-items-center"><div><h4 class="fw-bold mb-0"><i class="bi bi-car-front"></i> Dashboard Driver</h4><small class="text-muted">TEMPERA.ID - 1 file untuk semua driver</small></div><button onclick="logout()" class="btn btn-danger btn-sm">Logout</button></div>
<div id="welcome" class="alert alert-info mt-3"></div>
<div class="row g-3 mt-1">
<div class="col-6"><div class="card p-3 bg-light"><small class="text-muted">Nama</small><h6 id="d_nama" class="fw-bold">-</h6></div></div>
<div class="col-6"><div class="card p-3 bg-light"><small class="text-muted">Email Login</small><h6 id="d_email" class="fw-bold">-</h6></div></div>
<div class="col-6"><div class="card p-3 bg-light"><small class="text-muted">No HP</small><h6 id="d_hp" class="fw-bold">-</h6></div></div>
<div class="col-6"><div class="card p-3 bg-light"><small class="text-muted">Plat Mobil</small><h6 id="d_plat" class="fw-bold">-</h6></div></div>
</div>
